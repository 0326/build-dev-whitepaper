{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0326/build-dev-whitepaper/main/schemas/eval-run.schema.json",
  "title": "Developer whitepaper evaluation run",
  "description": "A reproducible record of expectation-level evaluation decisions and evidence.",
  "type": "object",
  "required": ["schema_version", "run_id", "variants"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "model": { "$ref": "#/$defs/nonEmpty" },
    "notes": { "type": "string" },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/variant" }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 120
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 10,
      "pattern": "^[^\\u0000]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)[^\\u0000]+$"
    },
    "catalog": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["label", "gates", "cases"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmpty" },
        "gates": { "type": "boolean" },
        "skill_revision": { "$ref": "#/$defs/nonEmpty" },
        "notes": { "type": "string" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/caseResult" }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "caseId": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "$ref": "#/$defs/id" }
      ]
    },
    "caseResult": {
      "type": "object",
      "required": ["case_id", "expectation_results"],
      "properties": {
        "case_id": { "$ref": "#/$defs/caseId" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "tokens": { "$ref": "#/$defs/tokens" },
        "output_artifact": { "$ref": "#/$defs/relativePath" },
        "error": { "type": "string" },
        "expectation_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectationResult" }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "expectationResult": {
      "type": "object",
      "required": ["expectation_index", "status", "reason", "evidence"],
      "properties": {
        "expectation_index": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["pass", "fail", "blocked", "not-run"] },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "enum": ["artifact", "output", "review", "test", "source"] },
        "locator": { "$ref": "#/$defs/nonEmpty" },
        "excerpt": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "duration_ms": { "type": "number", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "tokens": { "$ref": "#/$defs/tokens" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}

