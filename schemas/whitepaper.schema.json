{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0326/build-dev-whitepaper/main/schemas/whitepaper.schema.json",
  "title": "Developer whitepaper manifest",
  "description": "The maintained, version-aware source of truth for a developer whitepaper.",
  "type": "object",
  "required": ["schema_version", "project", "policy", "sources", "versions"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "project": { "$ref": "#/$defs/project" },
    "policy": { "$ref": "#/$defs/policy" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" },
      "uniqueItems": true
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version" },
      "uniqueItems": true
    },
    "settings": { "type": "object" }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 120
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^\\s]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)[^\\u0000]+$"
    },
    "project": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "repository": { "$ref": "#/$defs/httpUrl" },
        "description": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "allowed_release_channels",
        "included_release_channels",
        "default_version",
        "version_fallback"
      ],
      "properties": {
        "allowed_release_channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "included_release_channels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "default_version": { "$ref": "#/$defs/nonEmpty" },
        "version_fallback": { "const": "explicit-only" },
        "required_appendices": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "expected_body_groups": {
          "type": "integer",
          "minimum": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "sourceLock": {
      "type": "object",
      "required": ["source_id", "accessed"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "ref": { "$ref": "#/$defs/nonEmpty" },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "accessed": { "type": "string", "minLength": 10 },
        "scope": { "type": "string" },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "title", "kind", "order", "articles"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["body", "appendix"] },
        "order": { "type": "integer", "minimum": 0 },
        "articles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "id",
        "release_channel",
        "publication_state",
        "documentation_revision",
        "content_root",
        "source_locks",
        "groups",
        "articles"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "release_channel": { "$ref": "#/$defs/id" },
        "publication_state": { "enum": ["draft", "published"] },
        "documentation_revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_root": { "$ref": "#/$defs/relativePath" },
        "asset_root": {
          "anyOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "source_locks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceLock" },
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" },
          "uniqueItems": true
        },
        "articles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "article.schema.json" },
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "article_id", "kind", "text", "status", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "article_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["fact", "inference", "recommendation", "unknown"] },
        "text": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["proposed", "verified", "blocked"] },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  }
}
